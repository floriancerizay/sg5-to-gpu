# Copier en .env et adapter (lu par run.sh et config.py ; les variables déjà exportées priment)

# Clone de gpu-entrepot (obligatoire) : styles, pictogrammes et couches de production GPU (relatif à la racine du dépôt)
GPU_DIR=../gpu-entrepot

# GeoServer local de la planche (workspace GEOSERVER_CMP_WORKSPACE supprimé puis recréé à chaque passe).
# Port 8090 si le 8080 est déjà pris : JETTY_OPTS=jetty.http.port=8090 bash /usr/share/geoserver/bin/startup.sh
GEOSERVER_URL=http://localhost:8090/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
# Répertoire styles/img du data_dir (images et polices y sont copiées : droits d'écriture nécessaires)
GEOSERVER_STYLES_IMG=/usr/share/geoserver/data_dir/styles/img

# Interpréteur ayant accès à PyQGIS (rendu de référence QGIS)
QGIS_PYTHON=/usr/bin/python3

# Préfixe des images dans les SLD assemblés (data/slds)
SLD_IMG_URL=https://data.geopf.fr/annexes/gpu/geoserver/images/cnig/
